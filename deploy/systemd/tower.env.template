# Base configuration shared by every tower on this host.
#
# Installed to /etc/two-towers/tower.env by scripts/install_systemd.sh, which
# substitutes the paths below for the ones it detects. Edit the installed copy,
# not this template -- the installer will not overwrite an existing file.
#
# For a per-tower override, create /etc/two-towers/<tower_id>.env with only the
# keys that differ; the unit reads it after this file. Example:
#
#     # /etc/two-towers/tower_b.env
#     TWO_TOWERS_LAUNCH_ARGS=enable_streaming:=false
#
# This is a systemd EnvironmentFile, not a shell script: no `export`, no
# command substitution, no variable expansion. VALUES ARE LITERAL.

# ---------------------------------------------------------------------------
# Paths
# ---------------------------------------------------------------------------
ROS_DISTRO_NAME=jazzy

# The colcon workspace root -- the directory containing install/setup.bash.
TWO_TOWERS_WORKSPACE=__WORKSPACE__

# The virtualenv created by scripts/bootstrap_pi.sh. run_tower.sh puts its bin/
# first on PATH, which is what makes the detector's `#!/usr/bin/env python3`
# resolve to the venv interpreter that can see ultralytics.
TWO_TOWERS_VENV=__VENV__

# ---------------------------------------------------------------------------
# ROS 2
# ---------------------------------------------------------------------------
# Set explicitly rather than left at the default 0. Towers only discover each
# other if they share a domain, and a shared default means every other ROS 2
# machine on the LAN joins the same graph. Both Pis must match.
ROS_DOMAIN_ID=42

# Jazzy defaults to Fast DDS. Discovery uses multicast, which many consumer
# mesh access points drop or rate-limit between wireless clients -- if the two
# towers cannot see each other's topics over Wi-Fi but can over Ethernet, that
# is the first thing to suspect.
RMW_IMPLEMENTATION=rmw_fastrtps_cpp

# ---------------------------------------------------------------------------
# Launch
# ---------------------------------------------------------------------------
# Extra arguments appended to `ros2 launch two_towers tower.launch.py`.
# tower_id is supplied by the unit instance name and must not be set here.
#
#     TWO_TOWERS_LAUNCH_ARGS=enable_streaming:=false launch_tracker:=false
TWO_TOWERS_LAUNCH_ARGS=
